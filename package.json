{
  "name": "@grec0/mcp-jenkins",
  "version": "0.3.0",
  "description": "MCP server para integración con Jenkins CI/CD",
  "license": "MIT",
  "author": "@grec0",
  "homepage": "https://github.com/gcorroto/mcp-jenkins",
  "bugs": "https://github.com/gcorroto/mcp-jenkins/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcorroto/mcp-jenkins.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jenkins",
    "ci-cd",
    "automation",
    "devops"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-jenkins": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch='**/tests/**/*.test.ts'",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "pack:dry-run": "npm pack --dry-run",
    "pack:verify": "npm run build && node scripts/verify-package.mjs",
    "smoke:tarball": "node scripts/verify-package.mjs --smoke-tarball",
    "check": "npm run pack:verify && npm test && npm run smoke:tarball",
    "prerelease": "npm run check",
    "release:minor": "npm run version:minor && git commit -am \"chore(release): v$(node -p \"require('./package.json').version\")\" && git push",
    "release:major": "npm run version:major && git commit -am \"chore(release): v$(node -p \"require('./package.json').version\")\" && git push"
  },
  "dependencies": {
    "@types/node": "^22",
    "@types/node-fetch": "^2.6.12",
    "axios": "^1.9.0",
    "universal-user-agent": "^7.0.2",
    "zod": "^4.2.0",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.2.6",
    "typescript": "^5.6.2",
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
